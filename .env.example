# Server-side only. Set the key locally, then restart npm run dev.
OPENROUTER_API_KEY=
# Optional provider/model ID; blank uses your OpenRouter account default.
# The selected model must support function tools.
OPENROUTER_MODEL=

# --- Hosting for other people (optional; see README) ---
# The public address visitors open. Gives each visitor a separate workspace and
# ignores the AFTERCARE_* app tokens below, so visitors connect their own apps.
AFTERCARE_PUBLIC_URL=
# Extra host names to answer for, comma-separated, such as a health check host.
AFTERCARE_ALLOWED_HOSTS=
# Set to 1 to let hosted visitors run AI investigations on your OpenRouter key.
AFTERCARE_HOSTED_AI=

# --- Saved workspaces (optional; see README) ---
# Usually set on the host, such as Render, whose disk is erased on restart.
# With all three set, workspaces are saved in Convex instead of .data/.
CONVEX_URL=
# At least 32 random characters, also set in Convex: npx convex env set AFTERCARE_CONVEX_TOKEN
AFTERCARE_CONVEX_TOKEN=
# 32 random bytes, base64url. Encrypts each workspace before it is sent; never set it in Convex.
AFTERCARE_STORE_KEY=

# --- Live demo apps (free accounts; see README) ---
# Repairs write to real GitHub, Linear and Slack records. Use dedicated demo
# resources and narrowly scoped tokens. Live mode stays off until all six are set.
AFTERCARE_GITHUB_TOKEN=
# owner/repo of an existing demo repository, e.g. your-name/aftercare-demo
AFTERCARE_GITHUB_REPO=
AFTERCARE_LINEAR_API_KEY=
# Team key from issue IDs, e.g. ENG for ENG-1
AFTERCARE_LINEAR_TEAM_KEY=
# Bot token (xoxb-...) with chat:write and channels:history
AFTERCARE_SLACK_BOT_TOKEN=
# Channel ID from the channel details, e.g. C0123456789; invite the app first
AFTERCARE_SLACK_CHANNEL_ID=

# --- Arga twins (optional; needs available Arga validation runs) ---
# The MCP endpoint and credential. If unset, the server falls back to the
# arga-context entry in ~/.codex/config.toml.
ARGA_MCP_URL=
ARGA_MCP_AUTHORIZATION=
# Optional provider credentials. The provision button requires MCP configuration;
# the GitHub minting fallback is implemented but remains unverified live.
ARGA_GITHUB_TOKEN=
ARGA_LINEAR_TOKEN=
ARGA_SLACK_TOKEN=
# Free plans cap a twin session at 10 minutes.
ARGA_TWIN_TTL_MINUTES=10
